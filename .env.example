# Create a bot with @BotFather and paste its token locally.
BOT_TOKEN=
DATABASE_PATH=deadlines.db
# Shared timezone for every student and study group in this installation.
APP_TIMEZONE=Asia/Novosibirsk
# Optional GigaChat API. Leave the key empty to use local parsing.
# Paste the Authorization Key from GigaChat Studio, not a temporary access token.
LLM_PROVIDER=gigachat
LLM_API_KEY=
LLM_MODEL=GigaChat-2
LLM_API_URL=https://api.giga.chat/v1/chat/completions
LLM_TIMEOUT=2.5
# App-only PEM trust bundle; the operating system certificate store is unchanged.
LLM_CA_BUNDLE=certs/russian_trusted_root_ca.pem
SCHEDULER_INTERVAL=30
LOG_LEVEL=INFO
