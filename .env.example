# Create a bot with @BotFather and paste its token locally.
BOT_TOKEN=
DATABASE_PATH=deadlines.db
# Shared timezone for every student and study group in this installation.
APP_TIMEZONE=Asia/Novosibirsk
# Optional NSU API. Leave the key empty to use local parsing.
# 'openai' selects the compatible API format, not a direct OpenAI service.
# Paste only the API key; the application adds the Bearer authorization prefix.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=Qwen3.8-27B
LLM_API_URL=https://deepcode.ci.nsu.ru/api/chat/completions
LLM_TIMEOUT=5
# Qwen: disable reasoning for concise JSON within the parsing time budget.
# Optional JSON object; leave empty for another model unless its API supports these parameters.
# Only thinking and enable_thinking with JSON true/false values are accepted.
LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
# Empty uses system-trusted certificates; an optional PEM bundle applies only to this app.
LLM_CA_BUNDLE=
SCHEDULER_INTERVAL=30
LOG_LEVEL=INFO
